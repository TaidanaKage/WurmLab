@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />
        <MudText Typo="Typo.h6" Class="ml-2">TK WurmLab</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(DarkLightModeButtonIcon)" Color="Color.Inherit" OnClick="@DarkModeToggle" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large">
            @Body
        </MudContainer>
    </MudMainContent>

    <Footer />

</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme? _theme;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
    }

    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#3F5243",                 // Deep Moss / Forest Green
        Secondary = "#9E4D2A",               // Warm Terracotta / Clay Rust
        Tertiary = "#8C6D46",                 // Aged Bronze
        Background = "#F5F2EB",               // Warm Parchment Paper
        Surface = "#FAF8F3",                  // Soft Vellum Surface
        AppbarBackground = "rgba(245, 242, 235, 0.9)",
        AppbarText = "#2C2723",
        DrawerBackground = "#EAE4D9",          // Aged Paper Drawer
        DrawerText = "#2C2723",
        DrawerIcon = "#4A5D4E",
        TextPrimary = "#2C2723",              // Deep Oak / Sepia Ink
        TextSecondary = "#60564D",            // Muted Charcoal Brown
        ActionDefault = "#4A5D4E",
        GrayLight = "#E2DDD3",
        GrayLighter = "#ECE7DE",
        LinesDefault = "#D5CEBF",
        TableLines = "#D5CEBF",
        Divider = "#DDD6C7",
        Info = "#4D6A75",                     // Muted Slate Blue
        Success = "#4A6E4F",                  // Herb Green
        Warning = "#B87A3B",                  // Warm Ember
        //Error = "#9E4747",                    // Rust Red
        Error = "#C82C2C", // Prominent Wax Seal Crimson
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7F9A83",                  // Soft Sage Green
        Secondary = "#BA9A7C",                // Warm Amber / Leather Gold
        Tertiary = "#9D8262",                 // Muted Brass
        Background = "#1A1D1A",               // Deep Night Forest / Dark Slate
        BackgroundGray = "#141614",
        Surface = "#222622",                  // Dark Moss Surface
        AppbarBackground = "rgba(26, 29, 26, 0.9)",
        AppbarText = "#E5DFD5",
        DrawerBackground = "#181A18",
        DrawerText = "#B8B2A6",
        DrawerIcon = "#7F9A83",
        TextPrimary = "#E5DFD5",              // Off-white Linen Text
        TextSecondary = "#A39E94",            // Soft Ash Text
        TextDisabled = "#ffffff33",
        ActionDefault = "#8F9E8B",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#3338334d",
        GrayLight = "#2C312C",
        GrayLighter = "#222622",
        LinesDefault = "#2E342E",
        TableLines = "#2E342E",
        Divider = "#353C35",
        OverlayLight = "#22262280",
        Info = "#628694",                     // Soft Steel Blue
        Success = "#5C8A62",                  // Muted Forest Green
        Warning = "#C98E4B",                  // Torch Light Yellow
        Error = "#E56E6E",
    };

    public string DarkLightModeButtonIcon => _isDarkMode switch
    {
        true => Icons.Material.Rounded.AutoMode,
        false => Icons.Material.Outlined.DarkMode,
    };
}
