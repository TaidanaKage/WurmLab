@page "/SettlementUpkeep"

<PageTitle>WurmLab - Settlement Upkeep</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2" Class="pb-5">Settlement Upkeep</MudText>

<MudGrid Spacing="4">

    @* Left section - user input *@
    <MudItem xs="12" md="6">
        <SettlementInput OnChanged="OnStateChanged" />
    </MudItem>

    @* Right section - calculated results *@
    <MudItem xs="12" md="6">
        <CostSummary @key="_renderVersion" />
    </MudItem>

    @* Bottom section - detailed, human readable explanation of the numbers above *@
    <MudItem xs="12">
        <CostBreakdown @key="_renderVersion" />
    </MudItem>

</MudGrid>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("Settlement Upkeep", href: null, disabled: true)
    ];

    // Bumped on every change so the read-only sections are rebuilt with the new values.
    private int _renderVersion;

    protected override void OnInitialized()
    {
        // Make sure the results are up to date when the page is first shown.
        FeatureState.Recalculate();
    }

    private void OnStateChanged()
    {
        _renderVersion++;
    }
}
