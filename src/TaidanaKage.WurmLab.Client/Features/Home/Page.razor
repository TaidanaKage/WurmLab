@page "/"

<PageTitle>TK WurmLab</PageTitle>

<MudText Typo="Typo.h2">Welcome</MudText>

<MudText Class="my-5">
    TK WurmLab is a small collection of browser-based tools for
    <MudLink Href="https://store.steampowered.com/app/366220/Wurm_Unlimited/" Target="_blank" Title="Wurm Unlimited on Steam">Wurm Unlimited</MudLink>
    and
    <MudLink Href="https://www.wurmonline.com/" Target="_blank" Title="Wurm Online official website">Wurm Online</MudLink>
    players.
</MudText>

<MudGrid Spacing="4" Class="my-5">

    <HomeCard Icon="@Icons.Material.Filled.Search"
              Title="Shard Analysis"
              Description="Visualizes minerals discovered while analyzing shards."
              Href="ShardAnalysis" />

    <HomeCard Icon="@Icons.Material.Filled.Terrain"
              Title="Surface Prospecting"
              Description="Visualizes minerals discovered while prospecting the surface."
              Href="SurfaceProspecting" />

    <HomeCard Icon="@Icons.Material.Filled.AccountBalance"
              Title="Settlement Upkeep"
              Description="Calculates the initial cost, monthly upkeep, and other settlement parameters."
              Href="SettlementUpkeep" />

    <HomeCard Icon="@Icons.Material.Filled.Foundation"
              Title="House Planner"
              Description="Calculates the required skills and materials for ground-floor house plans."
              Href="HousePlanner" />

    <HomeCard Icon="@Icons.Material.Filled.WaterDrop"
              Title="Water Divining"
              Description="Visualizes water sources based on divining results."
              Href="WaterDivining" />

    <HomeCard Icon="@Icons.Material.Filled.Lightbulb"
              Title="Suggest a Tool"
              Description="Have an idea for a tool? Share it here."
              Href="Contact" />

</MudGrid>
