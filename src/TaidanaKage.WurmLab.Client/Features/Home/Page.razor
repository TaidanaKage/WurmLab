@page "/"

<PageTitle>TK WurmLab</PageTitle>

<MudText Typo="Typo.h2">Welcome</MudText>

<MudText Class="my-5">TK WurmLab is a small collection of tools for Wurm Unlimited and Wurm Online players.</MudText>

<MudGrid Spacing="4" Class="my-5">

    <HomeCard Icon="@Icons.Material.Filled.Search"
              Title="Shard Analysis"
              Description="Visual mini-map for the shard analysis results."
              Href="ShardAnalysis" />

    <HomeCard Icon="@Icons.Material.Filled.Terrain"
              Title="Surface Prospecting"
              Description="Visual mini-map of ore types discovered while prospecting the surface."
              Href="SurfaceProspecting" />

    <HomeCard Icon="@Icons.Material.Filled.AccountBalance"
              Title="Settlement Upkeep"
              Description="Estimate the initial cost and monthly upkeep for a settlement."
              Href="SettlementUpkeep" />

    <HomeCard Icon="@Icons.Material.Filled.Foundation"
              Title="House Planner"
              Description="Design house layouts and check the required skills and materials."
              Href="HousePlanner" />

    <HomeCard Icon="@Icons.Material.Filled.WaterDrop"
              Title="Water Divining"
              Description="Visualizer for in-game water divining logs."
              Href="WaterDivining" />

    <HomeCard Icon="@Icons.Material.Filled.Lightbulb"
              Title="Suggest a Tool"
              Description="Have an idea for a tool? Let me know."
              Href="Contact" />

</MudGrid>
