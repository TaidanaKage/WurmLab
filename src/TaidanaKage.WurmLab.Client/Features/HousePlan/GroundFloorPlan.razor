<MudGrid Spacing="3">

    @* Left section: clickable tile grid *@
    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Ground Floor Layout</MudText>

            <div class="tile-grid" style="--grid-columns: @FeatureConfig.GridColumns; --tile-size: @(FeatureConfig.TileSize)px;">
                @for (int row = 0; row < FeatureConfig.GridRows; row++)
                {
                    for (int col = 0; col < FeatureConfig.GridColumns; col++)
                    {
                        // Capture loop variables for the lambda.
                        int r = row;
                        int c = col;

                        string tileClass = FeatureState.Tiles[r, c] ? "tile tile-enabled" : "tile tile-disabled";

                        <div class="@tileClass" @onclick="() => ToggleTile(r, c)"></div>
                    }
                }
            </div>
        </MudPaper>
    </MudItem>

    @* Right section: read-only calculated values *@
    <MudItem xs="12" md="4">

        @if (FeatureState.ValidationError is not null)
        {
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Error</MudText>

                <MudAlert Severity="Severity.Error">@FeatureState.ValidationError</MudAlert>
            </MudPaper>
        }
        else
        {

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Requirements</MudText>

                <MudField Label="Carpentry skill" Variant="Variant.Outlined" Class="mb-4">
                    @FeatureState.RequiredSkill
                </MudField>

                <MudSelect T="HouseType" Value="FeatureState.SelectedHouseType" ValueChanged="OnHouseTypeChanged" Label="House type" Variant="Variant.Outlined" Dense="true" Class="mb-4" ToStringFunc="@(h => h?.Name)">
                    @foreach (HouseType houseType in HouseTypes.All)
                    {
                        <MudSelectItem T="HouseType" Value="@houseType">@houseType.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudField Label="Materials" Variant="Variant.Outlined">
                    <div style="white-space: pre-line;">@FeatureState.RequiredMaterials</div>
                </MudField>

            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Breakdown</MudText>

                <MudField Label="Number of tiles" Variant="Variant.Outlined" Class="mb-4">
                    @FeatureState.TileCount
                </MudField>

                <MudField Label="Number of outer walls" Variant="Variant.Outlined" Class="mb-4">
                    @FeatureState.WallCount
                </MudField>

                <div style="white-space: pre-line;">@FeatureState.DetailedBreakdown</div>
            </MudPaper>

        }

        @* Drawing tools - preset shapes *@
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Preset shapes</MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudSelect T="PresetShape" @bind-Value="FeatureState.SelectedPreset" Label="Shape" Variant="Variant.Outlined" Dense="true" Style="max-width: 150px;" ToStringFunc="@(p => p?.Name)">
                    @foreach (PresetShape preset in PresetShapes.All)
                    {
                        <MudSelectItem T="PresetShape" Value="@preset">@preset.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="DrawPreset">Draw</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="UnselectAll">Clear all</MudButton>
            </MudStack>
        </MudPaper>

    </MudItem>

</MudGrid>

<style>
    .tile-grid {
        display: grid;
        grid-template-columns: repeat(var(--grid-columns), var(--tile-size));
        gap: 2px;
    }

    .tile {
        width: var(--tile-size);
        height: var(--tile-size);
        cursor: pointer;
        border: 1px solid var(--mud-palette-lines-default);
        transition: background-color 0.15s ease;
    }

    .tile-enabled {
        background-color: var(--mud-palette-primary);
    }

    .tile-disabled {
        background-color: var(--mud-palette-background-gray);
    }

    .tile:hover {
        opacity: 0.7;
    }
</style>

@code {
    protected override void OnInitialized()
    {
        // Ensure the displayed values match the current tile state on first render.
        FeatureUtils.Recalculate();
    }

    private void DrawPreset()
    {
        FeatureUtils.DrawPreset(FeatureState.SelectedPreset);
    }

    private void ToggleTile(int row, int col)
    {
        // Toggle between enabled and disabled states.
        FeatureState.Tiles[row, col] = !FeatureState.Tiles[row, col];

        // Recalculate the requirements after every change.
        FeatureUtils.Recalculate();
    }

    private void UnselectAll()
    {
        FeatureUtils.UnselectAll();
    }

    private void OnHouseTypeChanged(HouseType houseType)
    {
        // Store the selection and refresh the material list.
        FeatureState.SelectedHouseType = houseType;
        FeatureUtils.Recalculate();
    }
}
