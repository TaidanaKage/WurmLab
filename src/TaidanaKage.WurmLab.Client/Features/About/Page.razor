@page "/About"

<PageTitle>TK WurmLab - About</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2" Class="mb-5">About</MudText>

<MudText Class="mb-5">
    TK WurmLab is a small collection of browser-based tools for Wurm Unlimited players.
    Everything runs locally in your browser. Nothing is uploaded to a server.
</MudText>

<MudGrid Spacing="4">

    <InfoCard Icon="@Icons.Custom.Brands.GitHub"
              Title="Source Code"
              Description="WurmLab is an open-source project. Issues and pull requests are welcome."
              Href="https://github.com/TaidanaKage/WurmLab"
              LinkText="github.com/TaidanaKage/WurmLab"
              IsExternal="true" />

    <InfoCard Icon="@Icons.Material.Filled.Public"
              Title="Riviera"
              Description="A Wurm Unlimited server I recommend. It is also the reason this app exists: a friend of mine plays there actively and kept complaining about how hard the plain-text analysis logs are to read."
              Href="https://riviera.thahenry.de/riviera"
              LinkText="riviera.thahenry.de/riviera"
              IsExternal="true" />

</MudGrid>

<MudText Typo="Typo.h6" Class="pt-8 pb-3">Wurm Unlimited on Steam</MudText>

<iframe src="https://store.steampowered.com/widget/366220/"
        frameborder="0"
        scrolling="no"
        style="width: 100%; max-width: 646px; height: 250px; border: 0;"
        title="Wurm Unlimited on Steam"></iframe>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("About", href: null, disabled: true)
    ];
}
