@page "/About"

<PageTitle>TK WurmLab - About</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2">About</MudText>

<MudText Class="my-5">
    TK WurmLab is a small collection of browser-based tools for Wurm Unlimited and Wurm Online players.
</MudText>

<MudText Class="my-5">
    Everything runs locally in your browser. Nothing is uploaded to a server.
</MudText>

<MudText Class="my-5">
    If you play on a modded Wurm Unlimited server with custom rules or mechanics, <MudLink Href="Contact">let me know</MudLink> so I can adjust the affected tools accordingly.
</MudText>

<MudGrid Spacing="4" Class="my-5">

    <InfoCard Icon="@Icons.Custom.Brands.GitHub"
              Title="Source Code"
              Description="WurmLab is an open-source project. Contributions are welcome."
              Href="https://github.com/TaidanaKage/WurmLab"
              LinkText="github.com/TaidanaKage/WurmLab"
              IsExternal="true" />

</MudGrid>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("About", href: null, disabled: true)
    ];
}
