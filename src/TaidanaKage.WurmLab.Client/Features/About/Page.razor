@page "/About"

<PageTitle>TK WurmLab - About</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2">About</MudText>

<MudText Class="my-5">
    TK WurmLab is a small collection of browser-based tools for
    <MudLink Href="https://store.steampowered.com/app/366220/Wurm_Unlimited/" Target="_blank" Title="Wurm Unlimited on Steam">Wurm Unlimited</MudLink>
    and
    <MudLink Href="https://www.wurmonline.com/" Target="_blank" Title="Wurm Online official website">Wurm Online</MudLink>
    players.
</MudText>

<MudText Class="my-5">
    This toolkit modernizes selected community tools into a lightning-fast, ad-free experience powered entirely by client-side 
    <MudLink Href="https://webassembly.org/" Target="_blank" Title="WebAssembly official website">WebAssembly</MudLink>.
</MudText>

<MudText Class="my-5">
    Everything runs locally in your browser. Nothing is uploaded to a server.
</MudText>

<MudGrid Spacing="4" Class="my-5">

    <InfoCard Icon="@Icons.Custom.Brands.GitHub"
              Title="Source Code"
              Description="This project will always remain free and open-source. Contributions are welcome."
              Href="https://github.com/TaidanaKage/WurmLab"
              LinkText="github.com/TaidanaKage/WurmLab"
              IsExternal="true" />

</MudGrid>

<MudText Class="my-5">
    If you play on a modded server with custom rules or mechanics, <MudLink Href="Contact">let me know</MudLink> so I can adjust the affected tools accordingly.
</MudText>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("About", href: null, disabled: true)
    ];
}
