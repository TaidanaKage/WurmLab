@page "/Contact"

<PageTitle>TK WurmLab - Contact</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2" Class="mb-5">Contact</MudText>

<MudGrid Spacing="4" Class="my-5">

    <InfoCard Icon="@Icons.Material.Filled.Email"
              Title="Feedback"
              Description="Found a bug or have an idea for a new tool? Send me an email."
              Href="mailto:taidana@kage.sk"
              LinkText="taidana@kage.sk" />

    <InfoCard Icon="@Icons.Custom.Brands.Discord"
              Title="Discord"
              Description="Join the Discord server to chat, ask questions, or report bugs."
              Href="https://discord.gg/cAxAwBQ3Pm"
              LinkText="discord.gg/cAxAwBQ3Pm"
              IsExternal="true" />

    <InfoCard Icon="@Icons.Custom.Brands.Steam"
              Title="Steam"
              Description="Feel free to add me on Steam."
              Href="https://steamcommunity.com/id/dsx75/"
              LinkText="steamcommunity.com/id/dsx75/"
              IsExternal="true" />

</MudGrid>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("Contact", href: null, disabled: true)
    ];
}
