@page "/Contact"

<PageTitle>TK WurmLab - Contact</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2" Class="mb-5">Contact</MudText>

<MudGrid Spacing="4">

    <MudItem xs="12" md="6">
        <MudCard Class="d-flex flex-column" Style="height: 100%;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" Size="Size.Large" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Feedback</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="flex-grow-1">
                <MudText Typo="Typo.body2">
                    Found a bug or have an idea for a new tool? Send me an email.
                </MudText>
                <MudLink Href="mailto:taidana@kage.sk" Typo="Typo.body2">
                    taidana@kage.sk
                </MudLink>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Class="d-flex flex-column" Style="height: 100%;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Custom.Brands.Steam" Color="Color.Primary" Size="Size.Large" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Steam</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="flex-grow-1">
                <MudText Typo="Typo.body2">
                    Feel free to add me on Steam.
                </MudText>
                <MudLink Href="https://steamcommunity.com/id/dsx75/"
                         Target="_blank"
                         Rel="noopener noreferrer"
                         Typo="Typo.body2">
                    steamcommunity.com/id/dsx75/
                </MudLink>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Class="d-flex flex-column" Style="height: 100%;">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudIcon Icon="@Icons.Custom.Brands.Discord" Color="Color.Primary" Size="Size.Large" />
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Discord</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="flex-grow-1">
                <MudText Typo="Typo.body2">
                    Join the Discord server to chat, ask questions, or report bugs.
                </MudText>
                <MudLink Href="https://discord.gg/cAxAwBQ3Pm"
                         Target="_blank"
                         Rel="noopener noreferrer"
                         Typo="Typo.body2">
                    discord.gg/cAxAwBQ3Pm
                </MudLink>
            </MudCardContent>
        </MudCard>
    </MudItem>

</MudGrid>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("Contact", href: null, disabled: true)
    ];
}
