@page "/ExternalLinks"

<PageTitle>TK WurmLab - External Links</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" />

<MudText Typo="Typo.h2">External Links</MudText>

<MudGrid Spacing="4" Class="my-5">

    <InfoCard Icon="@Icons.Material.Filled.Public"
              Title="Riviera"
              Description="A Wurm Unlimited server I recommend. It is also the reason this app exists: a friend of mine plays there actively and kept complaining about how hard the plain-text analysis logs are to read."
              Href="https://riviera.thahenry.de/riviera"
              LinkText="riviera.thahenry.de/riviera"
              IsExternal="true" />

</MudGrid>

<iframe src="https://store.steampowered.com/widget/366220/"
        frameborder="0"
        scrolling="no"
        style="width: 100%; max-width: 646px; height: 250px; border: 0;"
        title="Wurm Unlimited on Steam"></iframe>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new BreadcrumbItem("Home", href: "./"),
        new BreadcrumbItem("External Links", href: null, disabled: true)
    ];
}
