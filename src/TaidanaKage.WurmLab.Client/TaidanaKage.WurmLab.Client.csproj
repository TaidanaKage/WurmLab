<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AssemblyName>TaidanaKage.WurmLab.Client</AssemblyName>
    <RootNamespace>TaidanaKage.WurmLab.Client</RootNamespace>
    <StartupObject>TaidanaKage.WurmLab.Client.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.*" />
    <PackageReference Include="Phosphor.MudBlazor" Version="1.0.0" />
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

</Project>
